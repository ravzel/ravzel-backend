# ==============================================================
# RAVZEL AI ASSISTANT BACKEND CONFIGURATION
# ==============================================================

# Server Port (default: 5000)
PORT=5000

# Frontend URL allowed for CORS
CORS_ORIGIN=http://localhost:3000

# Google Gemini API Key (keep this secret, never commit to git)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash
